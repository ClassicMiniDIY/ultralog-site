    "sync:wiki": "bun scripts/sync-wiki.ts"
  },
  "dependencies": {
    "marked": "^18.1.1",
    "nuxt": "4.6.2",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24",
    "sharp": "^0.34",
    "tailwindcss": "^4.3.3",
    "typescript": "^6",
    "vitest": "^4",
    "vue-tsc": "^3.3.13",
    "wrangler": "4.152.0"
  }
