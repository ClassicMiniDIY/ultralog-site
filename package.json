{
  "name": "ultralog-site",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun scripts/sync-wiki.ts && nuxt dev",
    "build": "bun scripts/sync-wiki.ts && nuxt build",
    "generate": "bun scripts/sync-wiki.ts && nuxt generate",
    "preview": "bunx serve .output/public",
    "typecheck": "nuxt typecheck",
