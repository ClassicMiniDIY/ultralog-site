  },
  "dependencies": {
    "marked": "^18.2.0",
    "nuxt": "4.6.4",
    "vue": "^3.5.45",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "typescript": "^7",
    "vitest": "^5",
    "vue-tsc": "^3.3.14",
    "wrangler": "4.159.0"
  }
