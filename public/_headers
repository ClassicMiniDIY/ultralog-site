# Cloudflare Workers static assets: response headers (https://developers.cloudflare.com/workers/static-assets/headers/).
# The default for every asset is `public, max-age=0, must-revalidate`, so without these rules the
# browser re-checks every script, font and image on every page view and gets a 304 for each.
#
# /_nuxt/<file> is content-hashed by Vite: a new build gives a new name, so it never changes.
# `:file` matches one path segment, so /_nuxt/builds/latest.json and builds/meta/*.json (fixed
# names, read by Nuxt to detect a new deploy) keep the default and stay revalidated.
# Two rules that set the same header are joined with a comma, so no two rules here may overlap.
/_nuxt/:file
  Cache-Control: public, max-age=31536000, immutable

# Fixed-name images: a day fresh, then served stale while Cloudflare revalidates. Replacing a
# screenshot under the same name shows up within a day.
/screenshots/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/logos/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/og.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/favicon.svg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/favicon.ico
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
